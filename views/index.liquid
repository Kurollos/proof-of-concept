{% include 'partials/head' %}

<body>

{% include 'partials/header' %}

<main>

  <!-- HERO SECTION -->
  <section class="hero">

    <div class="hero-visual">
      <img
        src="https://assets.fstatic.nl/shared/images/funda_header.svg"
        alt="Hero illustratie"
      >
    </div>

    <div class="search-container">

      <!-- TABS -->
      <nav class="tabs" aria-label="Type woningen">

        <a href="/?type=koop" class="tab active">
          Koop
        </a>

        <a href="/?type=huur" class="tab">
          Huur
        </a>

        <a href="/?type=nieuwbouw" class="tab">
          Nieuwbouw
        </a>

        <a href="/?type=recreatie" class="tab">
          Recreatie
        </a>

        <a href="/?type=europa" class="tab">
          Europa
        </a>

      </nav>

      <!-- SEARCH BAR -->
      <form method="GET" class="search-form">

        <input
          type="text"
          name="query"
          placeholder="Zoek op plaats, buurt of postcode"
        >

        <button type="submit" class="search-btn">
          🔍
        </button>

        <a href="/map" class="map-link">
          🗺️ Zoek op kaart
        </a>

      </form>

    </div>

  </section>

  <!-- LISTINGS -->
  <section class="container">

    <h1>Woningen te koop</h1>

    <form method="GET" class="sort-form">

      <label for="sort">
        Sorteer:
      </label>

      <select name="sort" id="sort">

        <option value="">
          Standaard
        </option>

        <option
          value="a-z"
          {% if sort == "a-z" %}selected{% endif %}
        >
          A → Z (straat)
        </option>

        <option
          value="z-a"
          {% if sort == "z-a" %}selected{% endif %}
        >
          Z → A (straat)
        </option>

      </select>

      <!-- Progressive Enhancement:
           werkt zonder JavaScript -->
      <button type="submit">
        Sorteer
      </button>

    </form>

    {% assign sorted_listings = listings %}

    {% if sort == "a-z" %}
      {% assign sorted_listings = listings | sort: "street" %}
    {% elsif sort == "z-a" %}
      {% assign sorted_listings = listings | sort: "street" | reverse %}
    {% endif %}

    <!-- LISTING GRID -->
    <div class="listing-grid">

      {% for listing in sorted_listings %}

        <a
          href="/listing/{{ listing.id }}"
          class="card"
        >

          <img
            class="hero-image"
            src="https://fdnd-agency.directus.app/assets/{{ listing.poster_image }}"
            alt="Hoofdfoto van {{ listing.street }} {{ listing.house_nr }}"
          >

          <div class="card-content">

            <h2>
              {{ listing.street }} {{ listing.house_nr }}
            </h2>

            <p>
              {{ listing.postal_code }} {{ listing.city }}
            </p>

            <p class="price">
              € {{ listing.price | number_with_delimiter }}
            </p>

            <div class="facts">

              <span>
                {{ listing.m2 | default: "n.v.t." }} m²
              </span>

              <span>
                {{ listing.rooms | default: "n.v.t." }} kamers
              </span>

              <span>
                {{ listing.m2_garden | default: "n.v.t." }} m² tuin
              </span>

            </div>

          </div>

        </a>

      {% endfor %}

    </div>

  </section>

</main>

{% include 'partials/foot' %}

</body>